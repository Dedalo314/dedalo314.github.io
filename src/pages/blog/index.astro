---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Blog | Aletheia">
  <section class="max-w-4xl mx-auto py-12 sm:py-20 space-y-12 sm:space-y-16">
    <header class="text-center space-y-4 sm:space-y-6">
      <div
        class="inline-flex items-center px-3 py-1 text-[10px] sm:text-xs font-semibold uppercase tracking-widest border border-blue-500/20 bg-blue-500/10 text-blue-600 dark:text-blue-400 rounded-full mb-2 sm:mb-4 translate-text"
        data-es="Escritos y Perspectivas"
      >
        Writing & Insights
      </div>
      <h1
        class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-gray-900 dark:text-white translate-text"
        data-es="Perspectivas desde las Fronteras"
      >
        Insights from the <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-500"
          >Frontiers</span
        >
      </h1>
    </header>

    <div
      class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-12 px-4 sm:px-0"
      id="posts-grid"
    >
      {
        posts.map((post) => (
          <article
            class="post-card group relative bg-gray-50 dark:bg-gray-900/40 border border-gray-200 dark:border-gray-800/60 rounded-2xl overflow-hidden hover:border-blue-500/30 transition-all hover:shadow-[0_0_40px_-10px_rgba(59,130,246,0.1)]"
            data-lang={post.data.lang}
          >
            <div class="p-6 sm:p-8 space-y-4">
              <div class="flex items-center space-x-3 text-xs font-mono text-gray-500 uppercase tracking-tighter">
                <span
                  class="pub-date"
                  data-date={post.data.pubDate.toISOString()}
                >
                  {new Date(post.data.pubDate).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </span>
                <span class="w-1 h-1 bg-gray-300 dark:bg-gray-700 rounded-full" />
                <div class="flex gap-2">
                  {(post.data.tags || []).map((tag) => (
                    <span class="text-blue-600 dark:text-blue-500 font-bold uppercase tracking-wider">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
              <h2 class="text-2xl font-bold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-tight">
                <a
                  href={
                    post.data.lang === 'es'
                      ? `/es/blog/${post.data.originalSlug}`
                      : `/blog/${post.slug}`
                  }
                >
                  {post.data.title}
                </a>
              </h2>
              <p class="text-gray-600 dark:text-gray-500 line-clamp-3 font-sans leading-relaxed">
                {post.data.description}
              </p>
              <div class="pt-6">
                <a
                  href={
                    post.data.lang === 'es'
                      ? `/es/blog/${post.data.originalSlug}`
                      : `/blog/${post.slug}`
                  }
                  class="inline-flex items-center text-sm font-bold text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-white transition-all group-hover:translate-x-1 read-article"
                  data-en="Read Article"
                  data-es="Leer Artículo"
                >
                  Read Article{' '}
                  <span class="ml-2 transition-transform group-hover:translate-x-1">
                    &rarr;
                  </span>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  function updateBlogPage() {
    const lang = localStorage.getItem('lang') || 'en';
    const cards = document.querySelectorAll('.post-card');
    cards.forEach((card) => {
      (card as HTMLElement).style.display =
        card.getAttribute('data-lang') === lang ? 'block' : 'none';
    });

    document.querySelectorAll('.read-article').forEach((el) => {
      // Initialize data-en if missing
      if (!el.hasAttribute('data-en')) {
        el.setAttribute('data-en', el.childNodes[0].textContent?.trim() || '');
      }
      (el as HTMLElement).childNodes[0].textContent =
        el.getAttribute('data-' + lang) || '';
    });
    document.querySelectorAll('.translate-text').forEach((el) => {
      if (!el.hasAttribute('data-en')) {
        el.setAttribute('data-en', el.innerHTML.trim());
      }
      const translated = el.getAttribute('data-' + lang);
      if (translated) (el as HTMLElement).innerHTML = translated;
    });
    document.querySelectorAll('.pub-date').forEach((el) => {
      const date = new Date(el.getAttribute('data-date') || '');
      (el as HTMLElement).textContent = date.toLocaleDateString(
        lang === 'es' ? 'es-ES' : 'en-US',
        {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        }
      );
    });
  }

  updateBlogPage();
  window.addEventListener('storage', updateBlogPage);
</script>
